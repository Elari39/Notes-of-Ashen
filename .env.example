# 对外展示名称固定为 Notes of Ashen。
APP_DISPLAY_NAME="Notes of Ashen"

# 1Panel 反向代理目标：http://127.0.0.1:1270
WEB_PORT=1270
APP_TIMEOUT=610000

# 请在生产环境替换为足够长的随机密钥。
APP_AUTH_ACCESS_SECRET=please-change-this-secret-in-production
APP_AUTH_ACCESS_EXPIRE=7200
APP_AUTH_REFRESH_EXPIRE=604800

# 远程 MySQL / Redis / RabbitMQ。1Panel 部署前请替换为真实内网或受信任地址。
APP_DATABASE_DSN=notes_user:replace-with-db-password@tcp(mysql.example.com:3306)/notes_of_ashen?charset=utf8mb4&parseTime=true&loc=Local
APP_DATABASE_MAX_OPEN_CONNS=20
APP_DATABASE_MAX_IDLE_CONNS=10

APP_REDIS_ADDR=redis.example.com:6379
APP_REDIS_PASSWORD=replace-with-redis-password
APP_REDIS_DB=0

APP_RABBITMQ_ENABLED=true
APP_RABBITMQ_URL=amqp://rabbit_user:replace-with-rabbitmq-password@rabbitmq.example.com:5672/

APP_SEARCH_ENABLED=false
APP_MEILISEARCH_HOST=http://meilisearch:7700
# Docker 部署时该值同时作为 Meilisearch 容器的 Master Key，请在生产环境替换。
APP_MEILISEARCH_API_KEY=notes_of_ashen_meili_master_key
APP_MEILISEARCH_INDEX=articles

# QQ 邮箱 SMTP 验证码配置。生产启用时请在真实 .env 中填写授权码，不要提交到仓库。
APP_EMAIL_ENABLED=false
APP_EMAIL_SMTP_HOST=smtp.qq.com
APP_EMAIL_SMTP_PORT=465
APP_EMAIL_SMTP_USERNAME=
APP_EMAIL_SMTP_PASSWORD=
APP_EMAIL_FROM=
APP_EMAIL_FROM_NAME="Notes of Ashen"

# AI 辅助创作配置。生产环境请只在真实 .env 中填写 API Key，不要提交密钥。
APP_AI_ENABLED=false
APP_AI_BASE_URL=
APP_AI_API_KEY=
APP_AI_MODEL=
# 后台保存的 AI API Key 使用此密钥加密；生产环境请设置为不同于 APP_AUTH_ACCESS_SECRET 的长随机值。
APP_AI_KEY_ENCRYPTION_SECRET=
APP_AI_TIMEOUT_SECONDS=600
APP_AI_FIRST_BYTE_TIMEOUT_SECONDS=60
APP_AI_STREAM_TIMEOUT_SECONDS=300
APP_AI_NON_STREAM_TIMEOUT_SECONDS=600

# 可选：MaxMind GeoLite2/GeoIP2 City 数据库。Docker 部署默认读取容器内 /data/GeoLite2-City.mmdb。
APP_GEOIP_DATABASE_PATH=/data/GeoLite2-City.mmdb

# 可选：可信反向代理 CIDR。默认留空表示不信任 X-Forwarded-* / X-Real-IP。
APP_TRUSTED_PROXY_CIDRS=

# 可选：用于 docker compose 自动下载 GeoLite2-City.mmdb。只在真实 .env 中填写，不要提交密钥。
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# 可选：Prerender.io 爬虫预渲染。默认关闭；启用时请在真实 .env 中填写 Token。
PRERENDER_ENABLED=0
PRERENDER_SERVICE_URL=https://service.prerender.io
PRERENDER_TOKEN=

# GitHub 动态可选 Token。留空时使用公开匿名额度，不要提交真实 Token。
APP_GITHUB_TOKEN=
