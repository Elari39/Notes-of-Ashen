# 后端监听地址与端口。APP_PORT 仅用于本地非 Docker 启动；Compose 内部固定使用 19000。
APP_HOST=0.0.0.0
APP_PORT=19000

# 1Panel 反向代理目标：http://127.0.0.1:1270
WEB_PORT=1270
APP_TIMEOUT=610000
# Compose 专用网络。若与宿主机现有网段冲突，需同时调整子网、Web 固定地址、网桥网关可信代理 /32 和后端可信代理 /32。
APP_DOCKER_SUBNET=172.30.127.0/24
APP_WEB_IPV4_ADDRESS=172.30.127.10
# Web Nginx 仅信任直接上游（默认 Compose app 网桥网关）传入的 X-Forwarded-For；禁止配置宽泛公网网段。
WEB_TRUSTED_PROXY_CIDR=172.30.127.1/32

# 生产环境必须替换为足够长的随机密钥；后端会拒绝空值和示例占位值。
# 后台保存的 AI API Key 也使用由此值派生的独立用途密钥加密，轮换前请先阅读 README 的迁移说明。
APP_AUTH_ACCESS_SECRET=<REPLACE_WITH_LONG_RANDOM_SECRET>
APP_AUTH_ACCESS_EXPIRE=1800
APP_AUTH_REFRESH_EXPIRE=604800
# refreshToken 走 HttpOnly+SameSite=Strict Cookie；生产 HTTPS 保持 true。
# 本机 dev（HTTP）需设 false，否则浏览器不会保存 Cookie，刷新页面无法恢复会话。
APP_AUTH_COOKIE_SECURE=true
# 本机 HTTP 开发时取消下行注释：
# APP_AUTH_COOKIE_SECURE=false

# 生产环境设为 true，API 启动前会要求数据库站点设置中的 siteBaseUrl 为正式 HTTPS 地址。
# 本机 HTTP 开发保持 false，允许 siteBaseUrl 为空并回退到当前请求地址。
APP_REQUIRE_PUBLIC_SITE_URL=false

# 镜像 tag。复制模板后必须替换为本次发布的不可变版本号或 git commit hash。
# 未设置时 docker-compose.yml 仅在本地开发 fallback 到 latest；生产不得依赖该 fallback。
IMAGE_TAG=<REPLACE_WITH_IMMUTABLE_IMAGE_TAG>

# 可选 Compose 服务。默认只启动 Web、API、MySQL 与 Redis；启用能力开关时必须同步启用对应 profile：
# RabbitMQ：COMPOSE_PROFILES=messaging 与 APP_RABBITMQ_ENABLED=true
# 搜索：COMPOSE_PROFILES=search 与 APP_SEARCH_ENABLED=true
# RAG：COMPOSE_PROFILES=rag 与 APP_RAG_ENABLED=true
# 同时启用多个能力，例如：COMPOSE_PROFILES=messaging,search,rag
COMPOSE_PROFILES=

# 本地 Docker MySQL / Redis。生产部署前请替换所有 <REPLACE_...> 为强随机值。
APP_MYSQL_ROOT_PASSWORD=<REPLACE_WITH_LOCAL_MYSQL_ROOT_PASSWORD>
APP_MYSQL_USER=notes_user
APP_MYSQL_PASSWORD=<REPLACE_WITH_LOCAL_MYSQL_PASSWORD>
APP_DATABASE_DSN=notes_user:<REPLACE_WITH_LOCAL_MYSQL_PASSWORD>@tcp(mysql:3306)/notes_of_ashen?charset=utf8mb4&parseTime=true&loc=Local
APP_DATABASE_MAX_OPEN_CONNS=20
APP_DATABASE_MAX_IDLE_CONNS=10

# 内置 Docker Redis 使用 redis:6379；接入外部 Redis 时改为外部地址，并加载 docker-compose.external-redis.yml。
APP_REDIS_ADDR=redis:6379
# 内置 Redis：留空禁用认证；非空时该密码同时用于 Redis 容器、healthcheck 和 API。
# 外部 Redis：使用覆盖文件后，填写外部实例要求的密码。
APP_REDIS_PASSWORD=
APP_REDIS_DB=0

# 仅在 COMPOSE_PROFILES 包含 messaging 时填写强随机密码、URL 并设为 true；
# URL 中的账号和密码必须分别与下方 user/password 完全一致。
APP_RABBITMQ_USER=notes_user
APP_RABBITMQ_PASSWORD=
APP_RABBITMQ_ENABLED=false
APP_RABBITMQ_URL=
# 以下三项有默认值，通常无需修改；自定义时在此设置。
# APP_RABBITMQ_EXCHANGE=notes-of-ashen.events
# APP_RABBITMQ_QUEUE=notes-of-ashen.operation_logs
# APP_RABBITMQ_ROUTING_KEY=operation.log

# 是否启用搜索功能。启用时请同时将上方 COMPOSE_PROFILES 设置为 search，配置下方 Meilisearch 相关项，
# 并使用 docker compose --profile search up -d --build 启动。
APP_SEARCH_ENABLED=false
APP_MEILISEARCH_HOST=http://meilisearch:7700
# 搜索关闭时必须留空；启用搜索时再填写强随机值（同时作为 Meilisearch Master Key）。
APP_MEILISEARCH_API_KEY=
APP_MEILISEARCH_INDEX=articles
# Compose 启用搜索时默认以 production 模式启动 Meilisearch；必须配置强随机 Master Key。
MEILI_ENV=production

# RAG 使用 Qdrant 作为仅容器网络可见的可再生向量索引。启用时需同时设置
# APP_RAG_ENABLED=true、COMPOSE_PROFILES=rag，并使用 docker compose --profile rag 启动。
# DashScope URL、模型和 API Key 不属于进程环境变量，由管理员在后台 RAG 设置中保存。
APP_RAG_ENABLED=false
APP_QDRANT_URL=http://qdrant:6333
# 内置 Qdrant 不暴露宿主机端口，默认不启用 Qdrant API Key；接入受保护的外部 Qdrant 时填写。
APP_QDRANT_API_KEY=
APP_QDRANT_COLLECTION=rag_articles

# QQ 邮箱 SMTP 验证码配置。生产启用时请在真实 .env 中填写授权码，不要提交到仓库。
APP_EMAIL_ENABLED=false
APP_EMAIL_SMTP_HOST=smtp.qq.com
APP_EMAIL_SMTP_PORT=465
# TLS 模式：implicit(465 隐式 TLS) | starttls(587 STARTTLS) | none(明文,仅内网测试)
APP_EMAIL_TLS_MODE=implicit
APP_EMAIL_SMTP_USERNAME=
APP_EMAIL_SMTP_PASSWORD=
APP_EMAIL_FROM=
APP_EMAIL_FROM_NAME="Notes of Ashen"

# 本地媒体库。Compose 中固定挂载到 /data/media；单文件默认最大 10 MiB。
APP_MEDIA_ROOT=/data/media
APP_MEDIA_MAX_UPLOAD_BYTES=10485760
# 加密整站备份上传默认最大 1 GiB。若调大，需同步调整 WEB_BACKUP_MAX_BODY_SIZE。
APP_BACKUP_MAX_UPLOAD_BYTES=1073741824
WEB_BACKUP_MAX_BODY_SIZE=1025m

# 本地直跑默认留空；Compose 会在变量为空时默认信任 Web 容器固定地址。
# Web 前方若还有可信外层代理，请在真实 .env 中填写 Web /32 并追加其出口 CIDR（逗号分隔）。
APP_TRUSTED_PROXY_CIDRS=

# 可选：Prerender.io 爬虫预渲染。默认关闭；启用时请在真实 .env 中填写 Token。
PRERENDER_ENABLED=0
PRERENDER_SERVICE_URL=https://service.prerender.io
PRERENDER_TOKEN=

# 以下为预留变量（当前版本后端未读取，仅文档记录）：
# APP_DISPLAY_NAME=Notes of Ashen
# APP_GITHUB_TOKEN=
