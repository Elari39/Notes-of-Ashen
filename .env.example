# 对外展示名称固定为 Notes of Ashen。
APP_DISPLAY_NAME="Notes of Ashen"

# 1Panel 反向代理目标：http://127.0.0.1:1270
WEB_PORT=1270

# 请在生产环境替换为足够长的随机密钥。
APP_AUTH_ACCESS_SECRET=please-change-this-secret-in-production
APP_AUTH_ACCESS_EXPIRE=7200
APP_AUTH_REFRESH_EXPIRE=604800

MYSQL_ROOT_PASSWORD=notes_of_ashen_root_password
MYSQL_USER=notes_of_ashen
MYSQL_PASSWORD=notes_of_ashen_password

REDIS_PASSWORD=notes_of_ashen_redis_password

RABBITMQ_DEFAULT_USER=notes_of_ashen
RABBITMQ_DEFAULT_PASS=notes_of_ashen_rabbitmq_password
APP_RABBITMQ_ENABLED=true

APP_DATABASE_MAX_OPEN_CONNS=20
APP_DATABASE_MAX_IDLE_CONNS=10
APP_REDIS_DB=0

# QQ 邮箱 SMTP 验证码配置。生产启用时请在真实 .env 中填写授权码，不要提交到仓库。
APP_EMAIL_ENABLED=false
APP_EMAIL_SMTP_HOST=smtp.qq.com
APP_EMAIL_SMTP_PORT=465
APP_EMAIL_SMTP_USERNAME=
APP_EMAIL_SMTP_PASSWORD=
APP_EMAIL_FROM=
APP_EMAIL_FROM_NAME="Notes of Ashen"

# AI 辅助创作配置。生产环境请只在真实 .env 中填写 API Key，不要提交密钥。
APP_AI_ENABLED=false
APP_AI_BASE_URL=
APP_AI_API_KEY=
APP_AI_MODEL=
APP_AI_TIMEOUT_SECONDS=30
