# syntax=docker/dockerfile:1@sha256:87999aa3d42bdc6bea60565083ee17e86d1f3339802f543c0d03998580f9cb89

FROM golang:1.26-alpine@sha256:0178a641fbb4858c5f1b48e34bdaabe0350a330a1b1149aabd498d0699ff5fb2 AS builder

WORKDIR /src

ENV GOPROXY=https://goproxy.cn,direct
ENV GOSUMDB=sum.golang.google.cn

RUN apk add --no-cache ca-certificates tzdata

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/notes-of-ashen ./cmd/notes-of-ashen

FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce

WORKDIR /app

RUN apk add --no-cache ca-certificates tzdata wget

ENV TZ=Asia/Shanghai

COPY --from=builder /out/notes-of-ashen /app/notes-of-ashen
COPY etc /app/etc

# 以非 root 用户运行，降低 RCE 时的影响面；媒体卷首次创建时继承可写目录权限。
RUN adduser -D -u 10001 appuser \
    && mkdir -p /data/media \
    && chown -R appuser:appuser /app /data/media
USER appuser

EXPOSE 19000

ENTRYPOINT ["/app/notes-of-ashen"]
CMD ["-f", "/app/etc/notes-of-ashen.yaml"]
