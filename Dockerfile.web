# syntax=docker/dockerfile:1@sha256:87999aa3d42bdc6bea60565083ee17e86d1f3339802f543c0d03998580f9cb89

FROM node:22-alpine@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS builder

WORKDIR /app

RUN corepack enable

COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY frontend/ ./
RUN pnpm build

# 使用非 root 的 nginx 镜像，worker 进程以 uid 101 运行，监听非特权端口 8080。
FROM nginxinc/nginx-unprivileged:1.30-alpine@sha256:44e36330f74d4f3a1d4e222acca9e23b401fb87811a7597024502bb759c4dd49

ENV PRERENDER_ENABLED=0
ENV PRERENDER_SERVICE_URL=https://service.prerender.io
ENV PRERENDER_TOKEN=
ENV WEB_TRUSTED_PROXY_CIDR=172.30.127.1/32
ENV WEB_BACKUP_MAX_BODY_SIZE=1025m

COPY deploy/nginx/default.conf /etc/nginx/templates/default.conf.template
COPY deploy/nginx/10-limits.conf /etc/nginx/conf.d/10-limits.conf
COPY deploy/nginx/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 8080
