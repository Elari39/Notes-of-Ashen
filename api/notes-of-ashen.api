syntax = "v1"

info (
	title:   "Notes of Ashen API"
	desc:    "go-zero personal blog backend"
	author:  "Codex"
	version: "v1"
)

type EmptyResp {}

type IDPathReq {
	ID uint64 `path:"id"`
}

type ArticleVersionPathReq {
	ID        uint64 `path:"id"`
	VersionNo int    `path:"versionNo"`
}

type PageReq {
	Page int `form:"page,optional"`
	Size int `form:"size,optional"`
}

type RegisterReq {
	Account  string `json:"account"`
	Password string `json:"password"`
	Email    string `json:"email"`
	Nickname string `json:"nickname,optional"`
	// Optional. Empty means no avatar; non-empty must be http(s) URL.
	AvatarUrl string `json:"avatarUrl,optional"`
}

type LoginReq {
	Account  string `json:"account"`
	Password string `json:"password"`
}

type RefreshReq {
	RefreshToken string `json:"refreshToken"`
}

type TokenResp {
	AccessToken  string `json:"accessToken"`
	RefreshToken string `json:"refreshToken"`
	TokenType    string `json:"tokenType"`
	ExpiresIn    int64  `json:"expiresIn"`
}

type SiteSettingsResp {
	RegistrationEnabled bool   `json:"registrationEnabled"`
	HomeArticleLayout   string `json:"homeArticleLayout"`
	SiteTitle           string `json:"siteTitle"`
	SiteDescription     string `json:"siteDescription"`
	SiteKeywords        string `json:"siteKeywords"`
	SiteBaseUrl         string `json:"siteBaseUrl"`
}

type UpdateSiteSettingsReq {
	RegistrationEnabled bool   `json:"registrationEnabled"`
	HomeArticleLayout   string `json:"homeArticleLayout"`
	SiteTitle           string `json:"siteTitle,optional"`
	SiteDescription     string `json:"siteDescription,optional"`
	SiteKeywords        string `json:"siteKeywords,optional"`
	SiteBaseUrl         string `json:"siteBaseUrl,optional"`
}

type UpdateMeReq {
	Email     string `json:"email,optional"`
	AvatarUrl string `json:"avatarUrl,optional"`
	Nickname  string `json:"nickname,optional"`
}

type ChangePasswordReq {
	OldPassword string `json:"oldPassword"`
	NewPassword string `json:"newPassword"`
}

type UserResp {
	ID        uint64 `json:"id"`
	Account   string `json:"account"`
	Email     string `json:"email"`
	AvatarUrl string `json:"avatarUrl"`
	Nickname  string `json:"nickname"`
	Role      string `json:"role"`
	Status    string `json:"status"`
	CreatedAt string `json:"createdAt"`
	UpdatedAt string `json:"updatedAt"`
}

type UserListResp {
	Items []UserResp `json:"items"`
	Total int64      `json:"total"`
	Page  int        `json:"page"`
	Size  int        `json:"size"`
}

type UserStatusReq {
	Status string `json:"status"`
}

type UserRoleReq {
	Role string `json:"role"`
}

type UserStatusWithIDReq {
	ID     uint64 `path:"id"`
	Status string `json:"status"`
}

type UserRoleWithIDReq {
	ID   uint64 `path:"id"`
	Role string `json:"role"`
}

type ArticleReq {
	CategoryID     uint64   `json:"categoryId,optional"`
	Title          string   `json:"title"`
	Slug           string   `json:"slug"`
	Summary        string   `json:"summary,optional"`
	Content        string   `json:"content"`
	CoverURL       string   `json:"coverUrl,optional"`
	Status         string   `json:"status,optional"`
	ScheduledAt    string   `json:"scheduledAt,optional"`
	SEOTitle       string   `json:"seoTitle,optional"`
	SEODescription string   `json:"seoDescription,optional"`
	SEOKeywords    string   `json:"seoKeywords,optional"`
	TagIDs         []uint64 `json:"tagIds,optional"`
}

type ArticleWithIDReq {
	ID             uint64   `path:"id"`
	CategoryID     uint64   `json:"categoryId,optional"`
	Title          string   `json:"title"`
	Slug           string   `json:"slug"`
	Summary        string   `json:"summary,optional"`
	Content        string   `json:"content"`
	CoverURL       string   `json:"coverUrl,optional"`
	Status         string   `json:"status,optional"`
	ScheduledAt    string   `json:"scheduledAt,optional"`
	SEOTitle       string   `json:"seoTitle,optional"`
	SEODescription string   `json:"seoDescription,optional"`
	SEOKeywords    string   `json:"seoKeywords,optional"`
	TagIDs         []uint64 `json:"tagIds,optional"`
}

type ArticleStatusReq {
	Status string `json:"status"`
}

type ArticleStatusWithIDReq {
	ID     uint64 `path:"id"`
	Status string `json:"status"`
}

type ArticleListReq {
	Page       int    `form:"page,optional"`
	Size       int    `form:"size,optional"`
	Status     string `form:"status,optional"`
	Query      string `form:"q,optional"`
	CategoryID uint64 `form:"categoryId,optional"`
	TagID      uint64 `form:"tagId,optional"`
}

type CategoryResp {
	ID          uint64 `json:"id"`
	Name        string `json:"name"`
	Slug        string `json:"slug"`
	Description string `json:"description"`
	CreatedBy   uint64 `json:"createdBy"`
	CreatedAt   string `json:"createdAt"`
	UpdatedAt   string `json:"updatedAt"`
}

type CategoryListResp {
	Items []CategoryResp `json:"items"`
	Total int64          `json:"total"`
	Page  int            `json:"page"`
	Size  int            `json:"size"`
}

type TagResp {
	ID          uint64 `json:"id"`
	Name        string `json:"name"`
	Slug        string `json:"slug"`
	Description string `json:"description"`
	CreatedBy   uint64 `json:"createdBy"`
	CreatedAt   string `json:"createdAt"`
	UpdatedAt   string `json:"updatedAt"`
}

type TagListResp {
	Items []TagResp `json:"items"`
	Total int64     `json:"total"`
	Page  int       `json:"page"`
	Size  int       `json:"size"`
}

type ArticleResp {
	ID             uint64       `json:"id"`
	AuthorID       uint64       `json:"authorId"`
	CategoryID     uint64       `json:"categoryId,optional"`
	Title          string       `json:"title"`
	Slug           string       `json:"slug"`
	Summary        string       `json:"summary"`
	Content        string       `json:"content,optional"`
	CoverURL       string       `json:"coverUrl"`
	Status         string       `json:"status"`
	ViewCount      uint64       `json:"viewCount"`
	ScheduledAt    string       `json:"scheduledAt,optional"`
	PublishedAt    string       `json:"publishedAt,optional"`
	SEOTitle       string       `json:"seoTitle"`
	SEODescription string       `json:"seoDescription"`
	SEOKeywords    string       `json:"seoKeywords"`
	CreatedAt      string       `json:"createdAt"`
	UpdatedAt      string       `json:"updatedAt"`
	Tags           []TagResp    `json:"tags,optional"`
	Category       CategoryResp `json:"category,optional"`
}

type ArticleListResp {
	Items []ArticleResp `json:"items"`
	Total int64         `json:"total"`
	Page  int           `json:"page"`
	Size  int           `json:"size"`
}

type ArticleContextResp {
	Previous ArticleResp   `json:"previous,optional"`
	Next     ArticleResp   `json:"next,optional"`
	Related  []ArticleResp `json:"related"`
}

type ArticleVersionResp {
	ID                uint64   `json:"id"`
	ArticleID         uint64   `json:"articleId"`
	VersionNo         int      `json:"versionNo"`
	ChangedBy         uint64   `json:"changedBy"`
	AuthorID          uint64   `json:"authorId"`
	CategoryID        uint64   `json:"categoryId,optional"`
	Title             string   `json:"title"`
	Slug              string   `json:"slug"`
	Summary           string   `json:"summary"`
	Content           string   `json:"content,optional"`
	CoverURL          string   `json:"coverUrl"`
	Status            string   `json:"status"`
	ViewCount         uint64   `json:"viewCount"`
	ScheduledAt       string   `json:"scheduledAt,optional"`
	PublishedAt       string   `json:"publishedAt,optional"`
	SEOTitle          string   `json:"seoTitle"`
	SEODescription    string   `json:"seoDescription"`
	SEOKeywords       string   `json:"seoKeywords"`
	TagIDs            []uint64 `json:"tagIds"`
	OriginalCreatedAt string   `json:"originalCreatedAt,optional"`
	OriginalUpdatedAt string   `json:"originalUpdatedAt,optional"`
	CreatedAt         string   `json:"createdAt"`
}

type ArticleVersionListResp {
	Items []ArticleVersionResp `json:"items"`
	Total int64                `json:"total"`
	Page  int                  `json:"page"`
	Size  int                  `json:"size"`
}

type AdminStatsResp {
	ArticleTotal    int64              `json:"articleTotal"`
	PublishedTotal  int64              `json:"publishedTotal"`
	DraftTotal      int64              `json:"draftTotal"`
	ArchivedTotal   int64              `json:"archivedTotal"`
	ScheduledTotal  int64              `json:"scheduledTotal"`
	ViewTotal       uint64             `json:"viewTotal"`
	UserTotal       int64              `json:"userTotal"`
	CategoryTotal   int64              `json:"categoryTotal"`
	TagTotal        int64              `json:"tagTotal"`
	PopularArticles []ArticleResp      `json:"popularArticles"`
	RecentArticles  []ArticleResp      `json:"recentArticles"`
	RecentLogs      []OperationLogResp `json:"recentLogs"`
}

type TaxonomyReq {
	Name        string `json:"name"`
	Slug        string `json:"slug"`
	Description string `json:"description,optional"`
}

type TaxonomyWithIDReq {
	ID          uint64 `path:"id"`
	Name        string `json:"name"`
	Slug        string `json:"slug"`
	Description string `json:"description,optional"`
}

type OperationLogResp {
	ID           uint64 `json:"id"`
	UserID       uint64 `json:"userId,optional"`
	EventType    string `json:"eventType"`
	ResourceType string `json:"resourceType"`
	ResourceID   uint64 `json:"resourceId,optional"`
	Metadata     string `json:"metadata,optional"`
	IP           string `json:"ip"`
	UserAgent    string `json:"userAgent"`
	CreatedAt    string `json:"createdAt"`
}

type OperationLogListResp {
	Items []OperationLogResp `json:"items"`
	Total int64              `json:"total"`
	Page  int                `json:"page"`
	Size  int                `json:"size"`
}

service notesOfAshen-api {
	@handler rss
	get /rss.xml

	@handler sitemap
	get /sitemap.xml

	@handler register
	post /api/v1/auth/register (RegisterReq) returns (TokenResp)

	@handler login
	post /api/v1/auth/login (LoginReq) returns (TokenResp)

	@handler refresh
	post /api/v1/auth/refresh (RefreshReq) returns (TokenResp)

	@handler articleList
	get /api/v1/articles (ArticleListReq) returns (ArticleListResp)

	@handler articleContext
	get /api/v1/articles/:id/context (IDPathReq) returns (ArticleContextResp)

	@handler articleDetail
	get /api/v1/articles/:id (IDPathReq) returns (ArticleResp)

	@handler categoryList
	get /api/v1/categories (PageReq) returns (CategoryListResp)

	@handler tagList
	get /api/v1/tags (PageReq) returns (TagListResp)

	@handler siteSettings
	get /api/v1/site/settings returns (SiteSettingsResp)

	@handler logout
	post /api/v1/auth/logout (RefreshReq) returns (EmptyResp)

	@handler me
	get /api/v1/users/me returns (UserResp)

	@handler updateMe
	put /api/v1/users/me (UpdateMeReq) returns (UserResp)

	@handler changePassword
	put /api/v1/users/me/password (ChangePasswordReq) returns (EmptyResp)

	@handler articleCreate
	post /api/v1/articles (ArticleReq) returns (ArticleResp)

	@handler articlePreview
	get /api/v1/articles/:id/preview (IDPathReq) returns (ArticleResp)

	@handler articleListVersions
	get /api/v1/articles/:id/versions (IDPathReq) returns (ArticleVersionListResp)

	@handler articleVersionDetail
	get /api/v1/articles/:id/versions/:versionNo (ArticleVersionPathReq) returns (ArticleVersionResp)

	@handler articleRestoreVersion
	post /api/v1/articles/:id/versions/:versionNo/restore (ArticleVersionPathReq) returns (ArticleResp)

	@handler articleUpdate
	put /api/v1/articles/:id (ArticleWithIDReq) returns (ArticleResp)

	@handler articleDelete
	delete /api/v1/articles/:id (IDPathReq) returns (EmptyResp)

	@handler articleUpdateStatus
	patch /api/v1/articles/:id/status (ArticleStatusWithIDReq) returns (ArticleResp)

	@handler categoryCreate
	post /api/v1/categories (TaxonomyReq) returns (CategoryResp)

	@handler categoryUpdate
	put /api/v1/categories/:id (TaxonomyWithIDReq) returns (CategoryResp)

	@handler categoryDelete
	delete /api/v1/categories/:id (IDPathReq) returns (EmptyResp)

	@handler tagCreate
	post /api/v1/tags (TaxonomyReq) returns (TagResp)

	@handler tagUpdate
	put /api/v1/tags/:id (TaxonomyWithIDReq) returns (TagResp)

	@handler tagDelete
	delete /api/v1/tags/:id (IDPathReq) returns (EmptyResp)

	@handler adminArticleList
	get /api/v1/admin/articles (ArticleListReq) returns (ArticleListResp)

	@handler adminStats
	get /api/v1/admin/stats returns (AdminStatsResp)

	@handler adminUserList
	get /api/v1/admin/users (PageReq) returns (UserListResp)

	@handler adminUpdateUserStatus
	patch /api/v1/admin/users/:id/status (UserStatusWithIDReq) returns (EmptyResp)

	@handler adminUpdateUserRole
	patch /api/v1/admin/users/:id/role (UserRoleWithIDReq) returns (EmptyResp)

	@handler adminLogList
	get /api/v1/admin/logs (PageReq) returns (OperationLogListResp)

	@handler adminUpdateSiteSettings
	put /api/v1/admin/site/settings (UpdateSiteSettingsReq) returns (SiteSettingsResp)
}
