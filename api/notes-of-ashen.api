// 本文件为接口文档/契约描述，项目从未使用 goctl 生成（无 Makefile/脚本，handler 与 routes 均为手写），
// 不参与编译。运行时唯一类型源为 internal/types/types.go，本文档应与之保持一致。
// 差异说明：
//   - 路径/查询参数由 handler 用 basehandler.PathID / basehandler.Query 手动解析，因此没有独立的
//     *WithIDReq 类型；:id 路径参数对应 IDPathReq，:id/:versionNo 对应 ArticleVersionPathReq。
//   - 文档型列表响应（UserListResp / CategoryListResp / TagListResp / OperationLogListResp）为
//     types.go 中泛型 ListResp[T] 的具体化展示，便于阅读。
//   - 时间字段统一为 time.Time（与 types.go 一致），指针类型用 *time.Time + omitempty。
//   - /healthz 为运维探活手写路由（见 internal/handler/site/healthz.go），不在此文件声明。

syntax = "v1"

info (
	title:   "Notes of Ashen API"
	desc:    "go-zero personal blog backend"
	author:  "Codex"
	version: "v1"
)

type EmptyResp {}

type IDPathReq {
	ID uint64 `path:"id"`
}

type ArticleVersionPathReq {
	ID        uint64 `path:"id"`
	VersionNo int    `path:"versionNo"`
}

type PageReq {
	Page int `json:"page,optional"`
	Size int `json:"size,optional"`
}

type RegisterReq {
	Account   string `json:"account"`
	Password  string `json:"password"`
	Email     string `json:"email"`
	// Required for normal registration. Optional only for the first admin when email service is disabled.
	EmailCode string `json:"emailCode,optional"`
	Nickname  string `json:"nickname,optional"`
	// Optional. Empty means no avatar; non-empty must be http(s) URL.
	AvatarURL string `json:"avatarUrl,optional"`
}

type LoginReq {
	Account     string `json:"account"`
	Password    string `json:"password"`
	CaptchaID   string `json:"captchaId"`
	CaptchaCode string `json:"captchaCode"`
}

type RefreshReq {
	// refreshToken 现由 HttpOnly Cookie 携带，缺失时 logic 层按未登录处理，故 optional。
	RefreshToken string `json:"refreshToken,optional"`
}

type CaptchaReq {
	Purpose string `json:"purpose,optional"`
}

type CaptchaResp {
	CaptchaID string `json:"captchaId"`
	ImageData string `json:"imageData"`
	ExpiresIn int64  `json:"expiresIn"`
}

type SendVerifyCodeReq {
	Email       string `json:"email"`
	Purpose     string `json:"purpose"`
	CaptchaID   string `json:"captchaId"`
	CaptchaCode string `json:"captchaCode"`
}

type ResetPasswordReq {
	Email       string `json:"email"`
	EmailCode   string `json:"emailCode"`
	NewPassword string `json:"newPassword"`
}

type TokenPair {
	AccessToken  string `json:"accessToken"`
	RefreshToken string `json:"refreshToken"`
	TokenType    string `json:"tokenType"`
	ExpiresIn    int64  `json:"expiresIn"`
}

type SiteSettingsResp {
	RegistrationEnabled           bool   `json:"registrationEnabled"`
	RegistrationEmailCodeRequired bool   `json:"registrationEmailCodeRequired"`
	HomeArticleLayout             string `json:"homeArticleLayout"`
	SiteTitle                     string `json:"siteTitle"`
	SiteDescription               string `json:"siteDescription"`
	SiteKeywords                  string `json:"siteKeywords"`
	SiteBaseURL                   string `json:"siteBaseUrl"`
	ResumePageEnabled             bool   `json:"resumePageEnabled"`
	ResumeNavHidden               bool   `json:"resumeNavHidden"`
	ProjectsPageEnabled           bool   `json:"projectsPageEnabled"`
	ProjectsNavHidden             bool   `json:"projectsNavHidden"`
}

type UpdateSiteSettingsReq {
	RegistrationEnabled *bool  `json:"registrationEnabled,optional"`
	HomeArticleLayout   string `json:"homeArticleLayout"`
	SiteTitle           string `json:"siteTitle,optional"`
	SiteDescription     string `json:"siteDescription,optional"`
	SiteKeywords        string `json:"siteKeywords,optional"`
	SiteBaseURL         string `json:"siteBaseUrl,optional"`
	ResumePageEnabled   *bool  `json:"resumePageEnabled,optional"`
	ResumeNavHidden     *bool  `json:"resumeNavHidden,optional"`
	ProjectsPageEnabled *bool  `json:"projectsPageEnabled,optional"`
	ProjectsNavHidden   *bool  `json:"projectsNavHidden,optional"`
}

type ResumePageResp {
	Title           string             `json:"title"`
	Subtitle        string             `json:"subtitle"`
	ContentMarkdown string             `json:"contentMarkdown"`
	Experiences     []ResumeExperience `json:"experiences"`
	Educations      []ResumeEducation  `json:"educations"`
	Skills          []ResumeSkill      `json:"skills"`
}

type UpdateResumePageReq {
	Title           string             `json:"title"`
	Subtitle        string             `json:"subtitle,optional"`
	ContentMarkdown string             `json:"contentMarkdown,optional"`
	Experiences     []ResumeExperience `json:"experiences,optional"`
	Educations      []ResumeEducation  `json:"educations,optional"`
	Skills          []ResumeSkill      `json:"skills,optional"`
}

type ResumeExperience {
	ID           uint64   `json:"id,optional,omitempty"`
	Role         string   `json:"role"`
	Organization string   `json:"organization"`
	Location     string   `json:"location"`
	StartDate    string   `json:"startDate"`
	EndDate      string   `json:"endDate"`
	Description  string   `json:"description"`
	Highlights   []string `json:"highlights"`
	DisplayOrder int      `json:"displayOrder"`
}

type ResumeEducation {
	ID           uint64   `json:"id,optional,omitempty"`
	School       string   `json:"school"`
	Degree       string   `json:"degree"`
	Major        string   `json:"major"`
	Location     string   `json:"location"`
	StartDate    string   `json:"startDate"`
	EndDate      string   `json:"endDate"`
	Description  string   `json:"description"`
	Highlights   []string `json:"highlights"`
	DisplayOrder int      `json:"displayOrder"`
}

type ResumeSkill {
	ID           uint64 `json:"id,optional,omitempty"`
	Category     string `json:"category"`
	Name         string `json:"name"`
	Level        int    `json:"level"`
	Description  string `json:"description"`
	DisplayOrder int    `json:"displayOrder"`
}

type ProjectItem {
	ID              string   `json:"id"`
	TagIDs          []uint64 `json:"tagIds,omitempty"`
	Title           string   `json:"title"`
	Summary         string   `json:"summary"`
	Role            string   `json:"role"`
	Period          string   `json:"period"`
	Tags            []string `json:"tags"`
	CoverURL        string   `json:"coverUrl"`
	DemoURL         string   `json:"demoUrl"`
	RepoURL         string   `json:"repoUrl"`
	ContentMarkdown string   `json:"contentMarkdown"`
	Featured        bool     `json:"featured"`
}

type ProjectsPageResp {
	Title    string        `json:"title"`
	Subtitle string        `json:"subtitle"`
	Items    []ProjectItem `json:"items"`
}

type UpdateProjectsPageReq {
	Title    string        `json:"title"`
	Subtitle string        `json:"subtitle,optional"`
	Items    []ProjectItem `json:"items"`
}

type UpdateMeReq {
	Email     string `json:"email,optional"`
	EmailCode string `json:"emailCode,optional"`
	AvatarURL string `json:"avatarUrl,optional"`
	Nickname  string `json:"nickname,optional"`
}

type ChangePasswordReq {
	OldPassword string `json:"oldPassword"`
	NewPassword string `json:"newPassword"`
	EmailCode   string `json:"emailCode"`
}

type UserVerifyCodeReq {
	Email       string `json:"email,optional"`
	Purpose     string `json:"purpose"`
	CaptchaID   string `json:"captchaId"`
	CaptchaCode string `json:"captchaCode"`
}

type UserResp {
	ID        uint64    `json:"id"`
	Account   string    `json:"account"`
	Email     string    `json:"email"`
	AvatarURL string    `json:"avatarUrl"`
	Nickname  string    `json:"nickname"`
	Role      string    `json:"role"`
	Status    string    `json:"status"`
	CreatedAt time.Time `json:"createdAt"`
	UpdatedAt time.Time `json:"updatedAt"`
}

// UserListResp 为文档展示用，对应 types.go 泛型 ListResp[UserResp]。
type UserListResp {
	Items []UserResp `json:"items"`
	Total int64      `json:"total"`
	Page  int        `json:"page"`
	Size  int        `json:"size"`
}

type UserStatusReq {
	Status string `json:"status"`
}

type UserRoleReq {
	Role string `json:"role"`
}

type ArticleReq {
	CategoryID      uint64     `json:"categoryId,optional"`
	Title           string     `json:"title"`
	Slug            string     `json:"slug"`
	Summary         string     `json:"summary,optional"`
	Content         string     `json:"content"`
	CoverURL        string     `json:"coverUrl,optional"`
	Status          string     `json:"status,optional"`
	ScheduledAt     *time.Time `json:"scheduledAt,optional"`
	IsPinned        *bool      `json:"isPinned,optional"`
	DisplayPriority *int       `json:"displayPriority,optional"`
	SEOTitle        string     `json:"seoTitle,optional"`
	SEODescription  string     `json:"seoDescription,optional"`
	SEOKeywords     string     `json:"seoKeywords,optional"`
	TagIDs          []uint64   `json:"tagIds,optional"`
}

type ArticleStatusReq {
	Status string `json:"status"`
}

type AIAssistReq {
	Action  string `json:"action"`
	Title   string `json:"title,optional"`
	Content string `json:"content"`
}

type AIAssistResp {
	Summary        string   `json:"summary,omitempty"`
	SEODescription string   `json:"seoDescription,omitempty"`
	SEOKeywords    string   `json:"seoKeywords,omitempty"`
	RevisedContent string   `json:"revisedContent,omitempty"`
	Suggestions    []string `json:"suggestions,omitempty"`
}

type AISettingsResp {
	Enabled                 bool   `json:"enabled"`
	BaseURL                 string `json:"baseUrl"`
	Model                   string `json:"model"`
	APIKeyConfigured        bool   `json:"apiKeyConfigured"`
	FirstByteTimeoutSeconds int    `json:"firstByteTimeoutSeconds"`
	StreamTimeoutSeconds    int    `json:"streamTimeoutSeconds"`
	NonStreamTimeoutSeconds int    `json:"nonStreamTimeoutSeconds"`
}

type UpdateAISettingsReq {
	Enabled                 bool   `json:"enabled"`
	BaseURL                 string `json:"baseUrl,optional"`
	APIKey                  string `json:"apiKey,optional"`
	ClearAPIKey             bool   `json:"clearApiKey,optional"`
	Model                   string `json:"model,optional"`
	FirstByteTimeoutSeconds int    `json:"firstByteTimeoutSeconds,optional"`
	StreamTimeoutSeconds    int    `json:"streamTimeoutSeconds,optional"`
	NonStreamTimeoutSeconds int    `json:"nonStreamTimeoutSeconds,optional"`
}

// ArticleListReq 由 handler 用 basehandler.Query 手动解析，tag 与 types.go 一致使用 json。
type ArticleListReq {
	Page       int    `json:"page,optional"`
	Size       int    `json:"size,optional"`
	Status     string `json:"status,optional"`
	Query      string `json:"q,optional"`
	CategoryID uint64 `json:"categoryId,optional"`
	TagID      uint64 `json:"tagId,optional"`
}

type CategoryResp {
	ID          uint64    `json:"id"`
	Name        string    `json:"name"`
	Slug        string    `json:"slug"`
	Description string    `json:"description"`
	CreatedBy   uint64    `json:"createdBy"`
	CreatedAt   time.Time `json:"createdAt"`
	UpdatedAt   time.Time `json:"updatedAt"`
}

// CategoryListResp 为文档展示用，对应 types.go 泛型 ListResp[CategoryResp]。
type CategoryListResp {
	Items []CategoryResp `json:"items"`
	Total int64          `json:"total"`
	Page  int            `json:"page"`
	Size  int            `json:"size"`
}

type TagResp {
	ID          uint64    `json:"id"`
	Name        string    `json:"name"`
	Slug        string    `json:"slug"`
	Description string    `json:"description"`
	CreatedBy   uint64    `json:"createdBy"`
	CreatedAt   time.Time `json:"createdAt"`
	UpdatedAt   time.Time `json:"updatedAt"`
}

// TagListResp 为文档展示用，对应 types.go 泛型 ListResp[TagResp]。
type TagListResp {
	Items []TagResp `json:"items"`
	Total int64     `json:"total"`
	Page  int       `json:"page"`
	Size  int       `json:"size"`
}

type ArticleSearchHighlights {
	Title   string `json:"title,omitempty"`
	Summary string `json:"summary,omitempty"`
	Content string `json:"content,omitempty"`
}

type ArticleResp {
	ID               uint64                   `json:"id"`
	AuthorID         uint64                   `json:"authorId"`
	CategoryID       uint64                   `json:"categoryId,omitempty"`
	Title            string                   `json:"title"`
	Slug             string                   `json:"slug"`
	Summary          string                   `json:"summary"`
	Content          string                   `json:"content,omitempty"`
	CoverURL         string                   `json:"coverUrl"`
	Status           string                   `json:"status"`
	ViewCount        uint64                   `json:"viewCount"`
	LikeCount        uint64                   `json:"likeCount"`
	ScheduledAt      *time.Time               `json:"scheduledAt,omitempty"`
	PublishedAt      *time.Time               `json:"publishedAt,omitempty"`
	IsPinned         bool                     `json:"isPinned"`
	DisplayPriority  int                      `json:"displayPriority"`
	SEOTitle         string                   `json:"seoTitle"`
	SEODescription   string                   `json:"seoDescription"`
	SEOKeywords      string                   `json:"seoKeywords"`
	CreatedAt        time.Time                `json:"createdAt"`
	UpdatedAt        time.Time                `json:"updatedAt"`
	Tags             []TagResp                `json:"tags,omitempty"`
	Category         *CategoryResp            `json:"category,omitempty"`
	SearchHighlights *ArticleSearchHighlights `json:"searchHighlights,omitempty"`
}

type ArticleListResp {
	Items []ArticleResp `json:"items"`
	Total int64         `json:"total"`
	Page  int           `json:"page"`
	Size  int           `json:"size"`
}

type ArticleContextResp {
	Previous *ArticleResp  `json:"previous,omitempty"`
	Next     *ArticleResp  `json:"next,omitempty"`
	Related  []ArticleResp `json:"related"`
}

type ArticleVersionResp {
	ID                uint64     `json:"id"`
	ArticleID         uint64     `json:"articleId"`
	VersionNo         int        `json:"versionNo"`
	ChangedBy         uint64     `json:"changedBy"`
	AuthorID          uint64     `json:"authorId"`
	CategoryID        uint64     `json:"categoryId,omitempty"`
	Title             string     `json:"title"`
	Slug              string     `json:"slug"`
	Summary           string     `json:"summary"`
	Content           string     `json:"content,omitempty"`
	CoverURL          string     `json:"coverUrl"`
	Status            string     `json:"status"`
	ViewCount         uint64     `json:"viewCount"`
	LikeCount         uint64     `json:"likeCount"`
	ScheduledAt       *time.Time `json:"scheduledAt,omitempty"`
	PublishedAt       *time.Time `json:"publishedAt,omitempty"`
	IsPinned          bool       `json:"isPinned"`
	DisplayPriority   int        `json:"displayPriority"`
	SEOTitle          string     `json:"seoTitle"`
	SEODescription    string     `json:"seoDescription"`
	SEOKeywords       string     `json:"seoKeywords"`
	TagIDs            []uint64   `json:"tagIds"`
	OriginalCreatedAt *time.Time `json:"originalCreatedAt,omitempty"`
	OriginalUpdatedAt *time.Time `json:"originalUpdatedAt,omitempty"`
	CreatedAt         time.Time  `json:"createdAt"`
}

type ArticleVersionListResp {
	Items []ArticleVersionResp `json:"items"`
	Total int64                `json:"total"`
	Page  int                  `json:"page"`
	Size  int                  `json:"size"`
}

type SearchReindexResp {
	Indexed int  `json:"indexed"`
	Enabled bool `json:"enabled"`
}

type TrafficVisitReq {
	Path      string `json:"path"`
	RouteType string `json:"routeType"`
	ArticleID uint64 `json:"articleId,optional"`
	Referrer  string `json:"referrer,optional"`
}

type TrafficTrendPointResp {
	Date string `json:"date"`
	PV   int64  `json:"pv"`
	UV   int64  `json:"uv"`
}

type RefererStatResp {
	SourceType string `json:"sourceType"`
	SourceName string `json:"sourceName"`
	PV         int64  `json:"pv"`
}

type AdminStatsResp {
	ArticleTotal    int64                   `json:"articleTotal"`
	PublishedTotal  int64                   `json:"publishedTotal"`
	DraftTotal      int64                   `json:"draftTotal"`
	ArchivedTotal   int64                   `json:"archivedTotal"`
	ScheduledTotal  int64                   `json:"scheduledTotal"`
	ViewTotal       uint64                  `json:"viewTotal"`
	LikeTotal       uint64                  `json:"likeTotal"`
	TodayPV         int64                   `json:"todayPv"`
	TodayUV         int64                   `json:"todayUv"`
	UserTotal       int64                   `json:"userTotal"`
	CategoryTotal   int64                   `json:"categoryTotal"`
	TagTotal        int64                   `json:"tagTotal"`
	TrafficTrend    []TrafficTrendPointResp `json:"trafficTrend"`
	TopReferers     []RefererStatResp       `json:"topReferers"`
	PopularArticles []ArticleResp           `json:"popularArticles"`
	RecentArticles  []ArticleResp           `json:"recentArticles"`
	RecentLogs      []OperationLogResp      `json:"recentLogs"`
}

type TaxonomyReq {
	Name        string `json:"name"`
	Slug        string `json:"slug"`
	Description string `json:"description,optional"`
}

type OperationLogResp {
	ID           uint64    `json:"id"`
	UserID       uint64    `json:"userId,omitempty"`
	EventType    string    `json:"eventType"`
	ResourceType string    `json:"resourceType"`
	ResourceID   uint64    `json:"resourceId,omitempty"`
	Metadata     string    `json:"metadata,omitempty"`
	IP           string    `json:"ip"`
	UserAgent    string    `json:"userAgent"`
	CreatedAt    time.Time `json:"createdAt"`
}

// OperationLogListResp 为文档展示用，对应 types.go 泛型 ListResp[OperationLogResp]。
type OperationLogListResp {
	Items []OperationLogResp `json:"items"`
	Total int64              `json:"total"`
	Page  int                `json:"page"`
	Size  int                `json:"size"`
}

type ArticleLikeResp {
	Liked     bool   `json:"liked"`
	LikeCount uint64 `json:"likeCount"`
}

service notesOfAshen-api {
	@handler rss
	get /rss.xml

	@handler sitemap
	get /sitemap.xml

	@handler captcha
	post /api/v1/auth/captcha (CaptchaReq) returns (CaptchaResp)

	@handler sendVerifyCode
	post /api/v1/auth/verify-code/send (SendVerifyCodeReq) returns (EmptyResp)

	@handler register
	post /api/v1/auth/register (RegisterReq) returns (TokenPair)

	@handler login
	post /api/v1/auth/login (LoginReq) returns (TokenPair)

	@handler resetPassword
	post /api/v1/auth/password/reset (ResetPasswordReq) returns (EmptyResp)

	@handler refresh
	post /api/v1/auth/refresh (RefreshReq) returns (TokenPair)

	@handler trafficVisit
	post /api/v1/traffic/visit (TrafficVisitReq) returns (EmptyResp)

	@handler articleList
	get /api/v1/articles (ArticleListReq) returns (ArticleListResp)

	@handler articleContext
	get /api/v1/articles/:id/context (IDPathReq) returns (ArticleContextResp)

	@handler articleLike
	post /api/v1/articles/:id/like (IDPathReq) returns (ArticleLikeResp)

	@handler articleDetail
	get /api/v1/articles/:id (IDPathReq) returns (ArticleResp)

	@handler categoryList
	get /api/v1/categories (PageReq) returns (CategoryListResp)

	@handler tagList
	get /api/v1/tags (PageReq) returns (TagListResp)

	@handler siteSettings
	get /api/v1/site/settings returns (SiteSettingsResp)

	@handler siteResumePage
	get /api/v1/site/resume returns (ResumePageResp)

	@handler siteProjectsPage
	get /api/v1/site/projects returns (ProjectsPageResp)

	@handler logout
	post /api/v1/auth/logout (RefreshReq) returns (EmptyResp)

	@handler me
	get /api/v1/users/me returns (UserResp)

	@handler updateMe
	put /api/v1/users/me (UpdateMeReq) returns (UserResp)

	@handler userSendVerifyCode
	post /api/v1/users/me/verify-code/send (UserVerifyCodeReq) returns (EmptyResp)

	@handler changePassword
	put /api/v1/users/me/password (ChangePasswordReq) returns (EmptyResp)

	@handler articleCreate
	post /api/v1/articles (ArticleReq) returns (ArticleResp)

	@handler articleAIAssist
	post /api/v1/articles/ai/assist (AIAssistReq) returns (AIAssistResp)

	@handler articleImportMarkdown
	post /api/v1/articles/import returns (ArticleResp)

	@handler articlePreview
	get /api/v1/articles/:id/preview (IDPathReq) returns (ArticleResp)

	@handler articleExportMarkdown
	get /api/v1/articles/:id/export (IDPathReq)

	@handler articleListVersions
	get /api/v1/articles/:id/versions (IDPathReq) returns (ArticleVersionListResp)

	@handler articleVersionDetail
	get /api/v1/articles/:id/versions/:versionNo (ArticleVersionPathReq) returns (ArticleVersionResp)

	@handler articleRestoreVersion
	post /api/v1/articles/:id/versions/:versionNo/restore (ArticleVersionPathReq) returns (ArticleResp)

	@handler articleUpdate
	put /api/v1/articles/:id (ArticleReq) returns (ArticleResp)

	@handler articleDelete
	delete /api/v1/articles/:id (IDPathReq) returns (EmptyResp)

	@handler articleUpdateStatus
	patch /api/v1/articles/:id/status (ArticleStatusReq) returns (ArticleResp)

	@handler categoryCreate
	post /api/v1/categories (TaxonomyReq) returns (CategoryResp)

	@handler categoryUpdate
	put /api/v1/categories/:id (TaxonomyReq) returns (CategoryResp)

	@handler categoryDelete
	delete /api/v1/categories/:id (IDPathReq) returns (EmptyResp)

	@handler tagCreate
	post /api/v1/tags (TaxonomyReq) returns (TagResp)

	@handler tagUpdate
	put /api/v1/tags/:id (TaxonomyReq) returns (TagResp)

	@handler tagDelete
	delete /api/v1/tags/:id (IDPathReq) returns (EmptyResp)

	@handler adminArticleList
	get /api/v1/admin/articles (ArticleListReq) returns (ArticleListResp)

	@handler adminStats
	get /api/v1/admin/stats returns (AdminStatsResp)

	@handler adminAISettings
	get /api/v1/admin/ai/settings returns (AISettingsResp)

	@handler adminUpdateAISettings
	put /api/v1/admin/ai/settings (UpdateAISettingsReq) returns (AISettingsResp)

	@handler adminUserList
	get /api/v1/admin/users (PageReq) returns (UserListResp)

	@handler adminUpdateUserStatus
	patch /api/v1/admin/users/:id/status (UserStatusReq) returns (EmptyResp)

	@handler adminUpdateUserRole
	patch /api/v1/admin/users/:id/role (UserRoleReq) returns (EmptyResp)

	@handler adminLogList
	get /api/v1/admin/logs (PageReq) returns (OperationLogListResp)

	@handler adminSearchReindex
	post /api/v1/admin/search/reindex returns (SearchReindexResp)

	@handler adminUpdateSiteSettings
	put /api/v1/admin/site/settings (UpdateSiteSettingsReq) returns (SiteSettingsResp)

	@handler adminResumePage
	get /api/v1/admin/site/resume returns (ResumePageResp)

	@handler adminUpdateResumePage
	put /api/v1/admin/site/resume (UpdateResumePageReq) returns (ResumePageResp)

	@handler adminProjectsPage
	get /api/v1/admin/site/projects returns (ProjectsPageResp)

	@handler adminUpdateProjectsPage
	put /api/v1/admin/site/projects (UpdateProjectsPageReq) returns (ProjectsPageResp)
}
